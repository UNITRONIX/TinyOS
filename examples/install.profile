profile.name=developer-installed-vm
profile.version=0
install.mode=terminal
install.media=iso
install.target=disk-image
target.arch=i686
target.platform=pc-bios-qemu
disk.target=/dev/vda
disk.partition=single-system
device.name=tinyos-dev-vm
network.mode=disabled
network.interface=none
user.name=developer
user.display_name=TinyOS Developer
credential.bootstrap=prompt
admin.mode=same-bootstrap-secret
security.password_hashing=required
security.plaintext_secrets=forbidden
provisioning.encryption=required
provisioning.remote_access=disabled
provisioning.profile=project.tinyos
receipt.write=planned
rollback=planned